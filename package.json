{
  "name": "rupa-cafe",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "concurrently \"npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "dist": "electron-builder"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "exceljs": "^3.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.18.0",
    "razorpay": "^2.9.6",
    "sib-api-v3-sdk": "^8.5.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^42.3.0",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.sg.restaurant",
    "productName": "Rupa Cafe",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "server.js",
      "package.json",
      "public/**/*",
      "admin/**/*",
      "data/**/*",
      "uploads/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
